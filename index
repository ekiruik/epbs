<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ePBS Dashboard — NASCOP/KRCS</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
:root{--bg:#0a0f1e;--surface:#111827;--surface2:#1a2235;--border:rgba(255,255,255,0.07);--accent:#00d4aa;--accent2:#4f9cf9;--text:#e2e8f0;--muted:#64748b;--danger:#ef4444;--success:#22c55e;--warn:#f59e0b;--font:"DM Sans",sans-serif;--mono:"DM Mono",monospace}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:var(--font);font-size:14px}
.header{background:#fff;border-bottom:3px solid #006633}
.logo-bar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:12px 20px;gap:12px}
.logo-slot{display:flex;align-items:center}
.logo-slot.left{justify-content:flex-start}
.logo-slot.center{justify-content:center}
.logo-slot.right{justify-content:flex-end}
.logo-box{display:flex;flex-direction:column;align-items:center;gap:4px}
.logo-img{height:62px;width:auto;object-fit:contain}
.logo-img.lg{height:74px}
.logo-name{font-size:10px;font-weight:700;color:#1a3c5e;letter-spacing:.04em;text-align:center}
.logo-full{font-size:9px;color:#64748b;text-align:center;max-width:120px;line-height:1.3}
.title-bar{background:#006633;text-align:center;padding:9px 20px 11px}
.title-bar h1{font-size:14px;font-weight:700;color:#fff;letter-spacing:.06em;text-transform:uppercase}
.title-bar p{font-size:10px;color:rgba(255,255,255,.75);margin-top:3px}
.filterbar{display:flex;gap:6px;flex-wrap:wrap;padding:9px 20px;background:var(--surface);border-bottom:1px solid var(--border)}
select{background:var(--surface2);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:5px 9px;font-family:var(--font);font-size:11px;cursor:pointer}
.refresh{margin-left:auto;background:var(--accent);color:#000;border:none;border-radius:6px;padding:5px 13px;font-family:var(--font);font-size:11px;font-weight:600;cursor:pointer}
.refresh:hover{opacity:.85}
.main{padding:14px 20px;display:flex;flex-direction:column;gap:12px}
.banner{background:var(--surface2);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:7px;padding:8px 12px;font-size:11px;color:var(--muted);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.banner b{color:var(--text)}
.dot{width:7px;height:7px;border-radius:50%;background:var(--success);animation:pulse 2s infinite;flex-shrink:0}
.dot.grey{background:var(--muted);animation:none}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px}
.kpi{background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:12px 14px;border-bottom:3px solid transparent}
.kpi.g{border-bottom-color:var(--success)}.kpi.a{border-bottom-color:var(--warn)}.kpi.r{border-bottom-color:var(--danger)}
.kpi-lbl{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px}
.kpi-val{font-size:24px;font-weight:600;font-family:var(--mono);line-height:1}
.kpi-tgt{font-size:9px;margin-top:4px}
.kpi-tgt.met{color:var(--success)}.kpi-tgt.near{color:var(--warn)}.kpi-tgt.miss{color:var(--danger)}
.panels{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.panel{background:var(--surface);border:1px solid var(--border);border-radius:9px;padding:12px}
.full{grid-column:1/-1}
@media(max-width:600px){.panels{grid-template-columns:1fr}}
.ptitle{font-size:11px;font-weight:600;margin-bottom:2px}
.psub{font-size:10px;color:var(--muted);margin-bottom:10px}
.phead{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:10px}
.badge{font-size:9px;padding:2px 7px;border-radius:3px;font-weight:600;background:rgba(0,212,170,.15);color:var(--accent)}
.legend{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:7px}
.li{display:flex;align-items:center;gap:3px;font-size:9px;color:var(--muted)}
.lsq{width:8px;height:8px;border-radius:2px}
.bars{display:flex;flex-direction:column;gap:6px}
.brow{display:flex;align-items:center;gap:6px}
.blbl{font-size:10px;min-width:130px;flex-shrink:0}
.bbg{flex:1;height:7px;background:rgba(255,255,255,0.07);border-radius:3px;overflow:hidden}
.bfill{height:100%;border-radius:3px}
.bpct{font-size:10px;font-family:var(--mono);color:var(--muted);min-width:28px;text-align:right}
.ht{width:100%;border-collapse:collapse;font-size:10px}
.ht th{padding:4px 8px;text-align:left;color:var(--muted);font-size:9px;font-weight:500;border-bottom:1px solid var(--border);background:rgba(255,255,255,0.03)}
.ht td{padding:4px 8px;border-bottom:1px solid rgba(255,255,255,0.03)}
.ht tr:last-child td{border-bottom:none}
.hc{display:inline-block;padding:1px 6px;border-radius:3px;font-family:var(--mono);font-size:9px;font-weight:500}
.hg{background:rgba(34,197,94,.15);color:#86efac}.ha{background:rgba(245,158,11,.15);color:#fcd34d}.hr{background:rgba(239,68,68,.15);color:#fca5a5}
.at{width:100%;border-collapse:collapse;font-size:10px}
.at th{padding:5px 8px;text-align:left;font-size:9px;color:var(--muted);font-weight:500;border-bottom:1px solid var(--border);background:rgba(255,255,255,0.03)}
.at td{padding:5px 8px;border-bottom:1px solid rgba(255,255,255,0.04)}
.at tr:last-child td{border-bottom:none}
.pill{display:inline-block;font-size:9px;padding:2px 7px;border-radius:8px;font-weight:600}
.pd{background:rgba(34,197,94,.15);color:#86efac}.pp{background:rgba(245,158,11,.15);color:#fcd34d}.po{background:rgba(239,68,68,.15);color:#fca5a5}
.spinner-wrap{text-align:center;padding:40px;color:var(--muted);font-size:12px}
.spinner{width:28px;height:28px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 10px}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>

<div class="header">
  <div class="logo-bar">
    <div class="logo-slot left">
      <div class="logo-box">
        <img class="logo-img" src="data:image/png;base64," alt="NASCOP">
        <div class="logo-name">NASCOP</div>
        <div class="logo-full">National AIDS &amp; STI Control Programme</div>
      </div>
    </div>
    <div class="logo-slot center">
      <div class="logo-box">
        <img class="logo-img lg" src="data:image/png;base64," alt="Ministry of Health">
        <div class="logo-name">Ministry of Health</div>
        <div class="logo-full">Republic of Kenya</div>
      </div>
    </div>
    <div class="logo-slot right">
      <div class="logo-box">
        <img class="logo-img" src="data:image/png;base64," alt="Kenya Red Cross">
        <div class="logo-name">KRCS</div>
        <div class="logo-full">Kenya Red Cross Society</div>
      </div>
    </div>
  </div>
  <div class="title-bar">
    <h1>ePBS Dashboard</h1>
    <p>Assessing Outcomes in HIV Prevention and Treatment Programmes with Key Populations &mdash; Nairobi, Kenya</p>
  </div>
</div>

<div class="filterbar">
  <select id="fCounty" onchange="applyFilters()"><option value="all">All Counties</option></select>
  <select id="fSite"   onchange="applyFilters()"><option value="all">All Sites</option></select>
  <select id="fTyp"    onchange="applyFilters()">
    <option value="all">All Typologies</option>
    <option>FSW</option><option>MSM</option><option>TG</option>
    <option>PWID</option><option>AGYW</option><option>LDT</option><option>Fisherfolk</option>
  </select>
  <select id="fRound" onchange="applyFilters()">
    <option value="all">All Rounds</option>
    <option>R1</option><option>R2</option><option>R3</option><option>R4</option><option>R5</option>
  </select>
  <button class="refresh" onclick="loadData()">&#8635; Refresh</button>
</div>

<div class="main">
  <div class="banner">
    <div class="dot grey" id="statusDot"></div>
    <span id="bannerText">Connecting to Google Sheets...</span>
  </div>

  <div class="kpis" id="kpiRow">
    <div class="spinner-wrap"><div class="spinner"></div>Loading live data...</div>
  </div>

  <div class="panels" id="panels" style="display:none">
    <div class="panel">
      <div class="phead">
        <div><div class="ptitle">Indicator trend by round</div><div class="psub">% YES across all sessions</div></div>
        <span class="badge">Live</span>
      </div>
      <div class="legend">
        <span class="li"><span class="lsq" style="background:#00d4aa"></span>Condom</span>
        <span class="li"><span class="lsq" style="background:#4f9cf9"></span>HIV test</span>
        <span class="li"><span class="lsq" style="background:#f97316"></span>PrEP</span>
      </div>
      <div style="position:relative;height:170px"><canvas id="trendChart" role="img" aria-label="Trend chart">Trend data.</canvas></div>
    </div>
    <div class="panel">
      <div class="phead"><div><div class="ptitle">Barriers reported</div><div class="psub">% YES from tally</div></div></div>
      <div class="bars" id="barrierList"></div>
    </div>
    <div class="panel full">
      <div class="ptitle" style="margin-bottom:2px">Cross-site heat map</div>
      <div class="psub">Key indicators &mdash; all sites</div>
      <div style="overflow-x:auto"><table class="ht"><thead><tr><th>Site</th><th>County</th><th>Condom</th><th>HIV test</th><th>PrEP</th><th>ART</th><th>Satisfied</th></tr></thead><tbody id="heatBody"></tbody></table></div>
    </div>
    <div class="panel full">
      <div class="ptitle" style="margin-bottom:2px">Action plan tracker</div>
      <div class="psub">Site-level actions</div>
      <table class="at"><thead><tr><th>Site</th><th>County</th><th>Action</th><th>Lead</th><th>Deadline</th><th>Status</th></tr></thead><tbody id="actionBody"></tbody></table>
    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════════
//  YOUR APPS SCRIPT URL — data comes from here
// ═══════════════════════════════════════════════
const APPS_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwfWEOPpMbt7qbY8YkYTwSiUaPVTR9lj1acWfHEQbkK4ltmoPX9_OSZtzwGkdjVi0ofog/exec';

const VAR_MAP=[
  {q:4, var:'condom_lastsex', label:'Condom use last sex',    target:80},
  {q:13,var:'hiv_test',       label:'HIV test last 3 months', target:60},
  {q:21,var:'prep_current',   label:'Currently on PrEP',      target:50},
  {q:16,var:'art_enrolled',   label:'ART enrolled (PLHIV)',   target:90},
  {q:33,var:'satisfied',      label:'Satisfied w/ services',  target:75},
  {q:34,var:'respect',        label:'Staff respectful',       target:80},
];
const BARRIER_VARS=[
  {var:'stigma',         label:'Stigma at facility',   color:'#ef4444'},
  {var:'police_violence',label:'Police violence',       color:'#f97316'},
  {var:'peer_edu',       label:'Peer educator reached', color:'#22c55e'},
  {var:'services',       label:'Services accessed',     color:'#4f9cf9'},
];

function toNum(v){
  if(!v&&v!==0)return 0;
  const s=String(v).trim();
  if(s.endsWith('%'))return parseFloat(s)/100;
  const n=parseFloat(s);
  return isNaN(n)?0:n>1?n/100:n;
}

function normalise(rows){
  return rows.map(r=>({
    county:r['County']||r['county']||'',
    site:r['Site']||r['site']||r['Site Name']||'',
    typology:r['Typology']||r['typology']||'',
    round:r['Round']||r['round']||'',
    peer_edu:toNum(r['peer_edu']),rights_info:toNum(r['rights_info']),
    prevention:toNum(r['prevention']),condom_lastsex:toNum(r['condom_lastsex']),
    services:toNum(r['services']),hiv_test:toNum(r['hiv_test']),
    art_enrolled:toNum(r['art_enrolled']),arv_taking:toNum(r['arv_taking']),
    viral_supp:toNum(r['viral_supp']),prep_3mo:toNum(r['prep_3mo']),
    prep_current:toNum(r['prep_current']),sti_treated:toNum(r['sti_treated']),
    police_violence:toNum(r['police_violence']),stigma:toNum(r['stigma']),
    satisfied:toNum(r['satisfied']),respect:toNum(r['respect']),
  }));
}

let allRows=[],actionRows=[],filteredRows=[],tChart=null;
const avg=(rows,v)=>rows.length?rows.reduce((s,r)=>s+(r[v]||0),0)/rows.length:0;
const pct=(rows,v)=>Math.round(avg(rows,v)*100);
const cc=(v,t)=>v>=t?'g':v>=t-10?'a':'r';
const hc=(v,t)=>v>=t?'hg':v>=t-10?'ha':'hr';
const tc=(v,t)=>v>=t?'met':v>=t-10?'near':'miss';

function populateFilters(){
  const cs=document.getElementById('fCounty'),ss=document.getElementById('fSite');
  [...new Set(allRows.map(r=>r.county))].sort().forEach(c=>{if(![...cs.options].some(o=>o.value===c)){const o=document.createElement('option');o.value=o.textContent=c;cs.appendChild(o);}});
  [...new Set(allRows.map(r=>r.site))].sort().forEach(s=>{if(![...ss.options].some(o=>o.value===s)){const o=document.createElement('option');o.value=o.textContent=s;ss.appendChild(o);}});
}
function applyFilters(){
  const co=document.getElementById('fCounty').value,si=document.getElementById('fSite').value,
        ty=document.getElementById('fTyp').value,ro=document.getElementById('fRound').value;
  filteredRows=allRows.filter(r=>(co==='all'||r.county===co)&&(si==='all'||r.site===si)&&(ty==='all'||r.typology===ty)&&(ro==='all'||r.round===ro));
  renderAll();
}
function renderAll(){renderKPIs();renderTrend();renderBarriers();renderHeat();renderActions();document.getElementById('panels').style.display='grid';}

function renderKPIs(){
  const rows=filteredRows.length?filteredRows:allRows;
  document.getElementById('kpiRow').innerHTML=VAR_MAP.map(vm=>{
    const v=pct(rows,vm.var),t=vm.target,diff=v-t;
    return`<div class="kpi ${cc(v,t)}"><div class="kpi-lbl">Q${vm.q} &middot; ${vm.label}</div><div class="kpi-val">${v}%</div><div class="kpi-tgt ${tc(v,t)}">Target &ge;${t}% &nbsp;${v>=t?'&check; met':diff+'% gap'}</div></div>`;
  }).join('');
}
function renderTrend(){
  const rnds=['R1','R2','R3','R4','R5'];
  const series=[{var:'condom_lastsex',color:'#00d4aa',dash:[]},{var:'hiv_test',color:'#4f9cf9',dash:[4,3]},{var:'prep_current',color:'#f97316',dash:[2,3]}];
  const ds=series.map(s=>({data:rnds.map(r=>{const rr=allRows.filter(x=>x.round===r);return rr.length?pct(rr,s.var):null;}),borderColor:s.color,pointBackgroundColor:s.color,borderDash:s.dash,tension:.35,borderWidth:2,pointRadius:4,spanGaps:true}));
  ds.push({data:rnds.map(()=>80),borderColor:'rgba(255,255,255,0.15)',borderDash:[5,4],borderWidth:1,pointRadius:0});
  if(tChart)tChart.destroy();
  tChart=new Chart(document.getElementById('trendChart'),{type:'line',data:{labels:rnds,datasets:ds},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{color:'rgba(255,255,255,0.05)'},ticks:{color:'#64748b',font:{size:9}}},y:{min:0,max:100,grid:{color:'rgba(255,255,255,0.05)'},ticks:{color:'#64748b',font:{size:9},callback:v=>v+'%'}}}}});
}
function renderBarriers(){
  const rows=filteredRows.length?filteredRows:allRows;
  const vals=BARRIER_VARS.map(b=>pct(rows,b.var)),mx=Math.max(...vals,1);
  document.getElementById('barrierList').innerHTML=BARRIER_VARS.map((b,i)=>`<div class="brow"><span class="blbl">${b.label}</span><div class="bbg"><div class="bfill" style="width:${Math.round(vals[i]/mx*100)}%;background:${b.color}"></div></div><span class="bpct">${vals[i]}%</span></div>`).join('');
}
function renderHeat(){
  const hv=[{v:'condom_lastsex',t:80},{v:'hiv_test',t:60},{v:'prep_current',t:50},{v:'art_enrolled',t:90},{v:'satisfied',t:75}];
  const sites=[...new Set(allRows.map(r=>r.site))].slice(0,8);
  document.getElementById('heatBody').innerHTML=sites.map(s=>{
    const rr=allRows.filter(r=>r.site===s),co=rr[0]?.county||'';
    return`<tr><td>${s}</td><td>${co}</td>${hv.map(({v,t})=>{const val=pct(rr,v);return`<td><span class="hc ${hc(val,t)}">${val}%</span></td>`;}).join('')}</tr>`;
  }).join('');
}
function renderActions(){
  const sc={Done:'pd','In Progress':'pp','Overdue':'po'};
  document.getElementById('actionBody').innerHTML=actionRows.length?actionRows.map(a=>`<tr>
    <td>${a['Site Name']||a.site||''}</td><td>${a['County']||a.county||''}</td>
    <td>${a['Action Item']||a.action||''}</td><td>${a['Lead']||a.lead||''}</td>
    <td>${a['Deadline']||a.deadline||''}</td>
    <td><span class="pill ${sc[a['Status']||a.status]||'pp'}">${a['Status']||a.status||'Pending'}</span></td>
  </tr>`).join(''):'<tr><td colspan="6" style="color:#64748b;padding:10px">No action plans found</td></tr>';
}

async function loadData(){
  document.getElementById('statusDot').className='dot grey';
  document.getElementById('bannerText').textContent='Connecting to Google Sheets...';
  try{
    const res = await fetch(APPS_SCRIPT_URL + '?format=json');
    if(!res.ok) throw new Error('HTTP '+res.status);
    const json = await res.json();
    allRows    = normalise(json.data||[]);
    actionRows = json.actions||[];
    document.getElementById('statusDot').className='dot';
    document.getElementById('bannerText').innerHTML=
      '<b>'+allRows.length+'</b> records from Google Sheets &nbsp;&middot;&nbsp; Last sync: <b>'+new Date().toLocaleTimeString()+'</b>';
    populateFilters();
    applyFilters();
  }catch(e){
    document.getElementById('statusDot').className='dot grey';
    document.getElementById('bannerText').innerHTML='Could not load data: '+e.message+' &mdash; check Apps Script URL';
    document.getElementById('kpiRow').innerHTML='<div style="color:#ef4444;padding:20px;font-size:12px;text-align:center">Failed to connect to Google Sheets.<br>Check the APPS_SCRIPT_URL in this file.</div>';
  }
}

loadData();
</script>
</body>
</html>
