<script>
// ═══════════════════════════════════════════════════════
//  GOOGLE SHEETS CONFIG — saved in localStorage
// ═══════════════════════════════════════════════════════
let CFG = {
  sheetId: '',
  apiKey:  '',
  aggTab:  'Aggregator (Dashboard Feed)',
  actTab:  'ActionPlans',
};

function saveConfig() {
  try { localStorage.setItem('epbs_cfg', JSON.stringify(CFG)); } catch(e) {}
}
function loadConfig() {
  try {
    const s = localStorage.getItem('epbs_cfg');
    if (s) CFG = {...CFG, ...JSON.parse(s)};
  } catch(e) {}
}

function openConfig() {
  loadConfig();
  document.getElementById('inputSheetId').value = CFG.sheetId;
  document.getElementById('inputApiKey').value  = CFG.apiKey;
  document.getElementById('inputAggTab').value  = CFG.aggTab;
  document.getElementById('inputActTab').value  = CFG.actTab;
  document.getElementById('connStatus').className = 'conn-status';
  document.getElementById('connStatus').textContent = '';
  document.getElementById('configModal').classList.remove('hidden');
}

function closeConfig() {
  document.getElementById('configModal').classList.add('hidden');
}

// ═══════════════════════════════════════════════════════
//  GOOGLE SHEETS FETCH
// ═══════════════════════════════════════════════════════
async function fetchTab(tab) {
  const url = `https://sheets.googleapis.com/v4/spreadsheets/${CFG.sheetId}/values/${encodeURIComponent(tab)}?key=${CFG.apiKey}`;
  const r = await fetch(url);
  if (!r.ok) throw new Error(`HTTP ${r.status} — check Sheet ID, API key, and that the sheet is public (Viewer access).`);
  const json = await r.json();
  if (!json.values || json.values.length < 2) throw new Error('Sheet is empty or tab name is wrong.');
  const [headers, ...rows] = json.values;
  return rows.map(row => {
    const obj = {};
    headers.forEach((h, i) => obj[h.trim()] = (row[i] || '').toString().trim());
    return obj;
  });
}

function normaliseAgg(rows) {
  return rows.map(r => ({
    county:        r['County']    || r['county']    || '',
    site:          r['Site']      || r['site']      || r['Site Name'] || '',
    typology:      r['Typology']  || r['typology']  || '',
    round:         r['Round']     || r['round']     || '',
    peer_edu:      parseFloat(r['peer_edu']        || r['Peer Educator']||0),
    rights_info:   parseFloat(r['rights_info']     || 0),
    prevention:    parseFloat(r['prevention']      || 0),
    condom_lastsex:parseFloat(r['condom_lastsex']  || r['Condom_LastSex'] || 0),
    services:      parseFloat(r['services']        || 0),
    hiv_test:      parseFloat(r['hiv_test']        || r['TestedHIV_Last3Mo'] || 0),
    art_enrolled:  parseFloat(r['art_enrolled']    || r['Enrolled_ART'] || 0),
    arv_taking:    parseFloat(r['arv_taking']      || 0),
    viral_supp:    parseFloat(r['viral_supp']      || 0),
    prep_3mo:      parseFloat(r['prep_3mo']        || 0),
    prep_current:  parseFloat(r['prep_current']    || r['CurrentlyOnPrEP'] || 0),
    sti_treated:   parseFloat(r['sti_treated']     || 0),
    police_violence:parseFloat(r['police_violence']|| 0),
    stigma:        parseFloat(r['stigma']          || r['Barrier_Stigma'] || 0),
    satisfied:     parseFloat(r['satisfied']       || r['Satisfied_Service'] || 0),
    respect:       parseFloat(r['respect']         || 0),
  }));
}

async function connectSheets() {
  CFG.sheetId = document.getElementById('inputSheetId').value.trim();
  CFG.apiKey  = document.getElementById('inputApiKey').value.trim();
  CFG.aggTab  = document.getElementById('inputAggTab').value.trim();
  CFG.actTab  = document.getElementById('inputActTab').value.trim();

  const status = document.getElementById('connStatus');
  status.className = 'conn-status';
  status.textContent = 'Connecting...';

  if (!CFG.sheetId || !CFG.apiKey) {
    status.className = 'conn-status conn-err';
    status.textContent = 'Please enter both Sheet ID and API Key.';
    return;
  }

  try {
    const [aggRows, actRows] = await Promise.all([
      fetchTab(CFG.aggTab),
      fetchTab(CFG.actTab).catch(() => []),
    ]);
    allRows    = normaliseAgg(aggRows);
    actionRows = actRows;
    saveConfig();
    status.className = 'conn-status conn-ok';
    status.textContent = `Connected! ${allRows.length} records loaded from Google Sheets.`;
    document.getElementById('trendBadge').textContent = 'Live';
    document.getElementById('trendBadge').className = 'badge';
    document.getElementById('statusDot').className = 'dot';
    document.getElementById('bannerText').innerHTML =
      `<b>${allRows.length}</b> records from Google Sheets &nbsp;&middot;&nbsp; Last sync: <b>${new Date().toLocaleTimeString()}</b>`;
    saveConfig();
    setTimeout(closeConfig, 1200);
    populateFilters();
    applyFilters();
  } catch(e) {
    status.className = 'conn-status conn-err';
    status.textContent = 'Error: ' + e.message;
  }
}

function useSample() {
  allRows = makeSample();
  actionRows = SAMPLE_ACTIONS;
  closeConfig();
  document.getElementById('trendBadge').textContent = 'Sample';
  document.getElementById('trendBadge').className = 'badge-grey';
  document.getElementById('statusDot').className = 'dot grey';
  document.getElementById('bannerText').innerHTML =
    `<b>${allRows.length}</b> sample records &mdash; click <b>Google Sheets</b> to connect live data`;
  populateFilters();
  applyFilters();
}

// ═══════════════════════════════════════════════════════
//  VARIABLE MAP
// ═══════════════════════════════════════════════════════
const VAR_MAP = [
  {q:1, var:'peer_edu',        label:'Peer educator reached',     target:80},
  {q:2, var:'rights_info',     label:'Rights info received',       target:80},
  {q:3, var:'prevention',      label:'Prevention method used',     target:80},
  {q:4, var:'condom_lastsex',  label:'Condom use last sex',        target:80},
  {q:12,var:'services',        label:'Health services received',   target:80},
  {q:13,var:'hiv_test',        label:'HIV test last 3 months',     target:60},
  {q:16,var:'art_enrolled',    label:'ART enrolled (PLHIV)',       target:90},
  {q:17,var:'arv_taking',      label:'Currently taking ARV',       target:90},
  {q:19,var:'viral_supp',      label:'Virally suppressed',         target:90},
  {q:20,var:'prep_3mo',        label:'PrEP taken last 3 months',   target:50},
  {q:21,var:'prep_current',    label:'Currently on PrEP',          target:50},
  {q:26,var:'sti_treated',     label:'STI treated',                target:80},
  {q:28,var:'police_violence', label:'Police violence exp.',       target:null},
  {q:31,var:'stigma',          label:'Stigma by HCW exp.',         target:null},
  {q:33,var:'satisfied',       label:'Satisfied with services',    target:75},
  {q:34,var:'respect',         label:'Staff treated with respect', target:80},
];
const KPI_VARS = ['condom_lastsex','hiv_test','prep_current','art_enrolled','satisfied','respect'];
const BARRIER_VARS = [
  {var:'stigma',         label:'Stigma at facility',    color:'#ef4444'},
  {var:'police_violence',label:'Police violence',        color:'#f97316'},
  {var:'peer_edu',       label:'Peer educator reached',  color:'#22c55e'},
  {var:'services',       label:'Services accessed',      color:'#4f9cf9'},
];
const SAMPLE_ACTIONS = [
  {site:'Eastleigh DICE',county:'Nairobi',action:'Deploy additional peer educator',lead:'Site Manager',deadline:'2025-06-30',status:'In Progress'},
  {site:'Kibera DICE',county:'Nairobi',action:'Restock PrEP shortage R4',lead:'County Pharm.',deadline:'2025-06-15',status:'Done'},
  {site:'Likoni DICE',county:'Mombasa',action:'Staff sensitisation on respectful care',lead:'QI Lead',deadline:'2025-07-01',status:'Overdue'},
  {site:'Kondele DICE',county:'Kisumu',action:'Evening sessions for PWID',lead:'Outreach Coord.',deadline:'2025-07-15',status:'In Progress'},
  {site:'Bondeni DICE',county:'Nakuru',action:'Increase HIV testing promotion',lead:'Peer Educator',deadline:'2025-07-10',status:'In Progress'},
];

function makeSample() {
  const counties=['Nairobi','Mombasa','Kisumu','Nakuru','Eldoret'];
  const sites={Nairobi:['Eastleigh DICE','Kibera DICE','CBD Outreach'],Mombasa:['Likoni DICE','Old Town Clinic'],Kisumu:['Kondele DICE','Nyalenda Outreach'],Nakuru:['Bondeni DICE'],Eldoret:['Langas DICE']};
  const typs=['FSW','MSM','TG','PWID','AGYW'];
  const rows=[];
  for(let r=1;r<=5;r++){
    counties.forEach(co=>{(sites[co]||[]).forEach(si=>{typs.forEach(ty=>{
      const tr=(r-1)*0.025,row={county:co,site:si,typology:ty,round:'R'+r};
      VAR_MAP.forEach(v=>{const b=v.target?(v.target/100-0.18+Math.random()*0.32+tr):Math.random()*0.4;row[v.var]=Math.min(1,Math.max(0,parseFloat(b.toFixed(3))));});
      rows.push(row);
    });});});
  }
  return rows;
}

let allRows=[], actionRows=SAMPLE_ACTIONS, filteredRows=[], tChart=null;
const avg=(rows,v)=>rows.length?rows.reduce((s,r)=>s+(parseFloat(r[v])||0),0)/rows.length:0;
const pct=(rows,v)=>Math.round(avg(rows,v)*100);
const cc=(v,t)=>v>=t?'g':v>=t-10?'a':'r';
const hc=(v,t)=>v>=t?'hg':v>=t-10?'ha':'hr';
const tc=(v,t)=>v>=t?'met':v>=t-10?'near':'miss';

function populateFilters(){
  const cs=document.getElementById('fCounty'),ss=document.getElementById('fSite');
  [...new Set(allRows.map(r=>r.county))].sort().forEach(c=>{if(![...cs.options].some(o=>o.value===c)){const o=document.createElement('option');o.value=o.textContent=c;cs.appendChild(o);}});
  [...new Set(allRows.map(r=>r.site))].sort().forEach(s=>{if(![...ss.options].some(o=>o.value===s)){const o=document.createElement('option');o.value=o.textContent=s;ss.appendChild(o);}});
}
function applyFilters(){
  const co=document.getElementById('fCounty').value,si=document.getElementById('fSite').value,
        ty=document.getElementById('fTyp').value,ro=document.getElementById('fRound').value;
  filteredRows=allRows.filter(r=>(co==='all'||r.county===co)&&(si==='all'||r.site===si)&&(ty==='all'||r.typology===ty)&&(ro==='all'||r.round===ro));
  renderAll();
}
function renderAll(){renderKPIs();renderTrend();renderBarriers();renderHeat();renderActions();renderVarMap();}

function renderKPIs(){
  const rows=filteredRows.length?filteredRows:allRows;
  document.getElementById('kpiRow').innerHTML=KPI_VARS.map(vn=>{
    const vm=VAR_MAP.find(v=>v.var===vn);if(!vm)return'';
    const v=pct(rows,vn),t=vm.target||75,diff=v-t;
    return`<div class="kpi ${cc(v,t)}"><div class="kpi-lbl">Q${vm.q} &middot; ${vm.label}</div><div class="kpi-val">${v}%</div><div class="kpi-tgt ${tc(v,t)}">Target &ge;${t}% &nbsp;${v>=t?'&check; met':diff+'% gap'}</div></div>`;
  }).join('');
}
function renderTrend(){
  const rnds=['R1','R2','R3','R4','R5'];
  const series=[{var:'condom_lastsex',color:'#00d4aa',dash:[]},{var:'hiv_test',color:'#4f9cf9',dash:[4,3]},{var:'prep_current',color:'#f97316',dash:[2,3]}];
  const ds=series.map(s=>({data:rnds.map(r=>{const rr=allRows.filter(x=>x.round===r);return rr.length?pct(rr,s.var):null;}),borderColor:s.color,pointBackgroundColor:s.color,borderDash:s.dash,tension:.35,borderWidth:2,pointRadius:4,spanGaps:true}));
  ds.push({data:rnds.map(()=>80),borderColor:'rgba(255,255,255,0.15)',borderDash:[5,4],borderWidth:1,pointRadius:0});
  if(tChart)tChart.destroy();
  tChart=new Chart(document.getElementById('trendChart'),{type:'line',data:{labels:rnds,datasets:ds},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{color:'rgba(255,255,255,0.05)'},ticks:{color:'#64748b',font:{size:10}}},y:{min:0,max:100,grid:{color:'rgba(255,255,255,0.05)'},ticks:{color:'#64748b',font:{size:10},callback:v=>v+'%'}}}}});
}
function renderBarriers(){
  const rows=filteredRows.length?filteredRows:allRows.filter(r=>r.round==='R5');
  const vals=BARRIER_VARS.map(b=>pct(rows,b.var)),mx=Math.max(...vals,1);
  document.getElementById('barrierList').innerHTML=BARRIER_VARS.map((b,i)=>`<div class="brow"><span class="blbl">Q${VAR_MAP.find(v=>v.var===b.var)?.q||''} &middot; ${b.label}</span><div class="bbg"><div class="bfill" style="width:${Math.round(vals[i]/mx*100)}%;background:${b.color}"></div></div><span class="bpct">${vals[i]}%</span></div>`).join('');
}
function renderHeat(){
  const hv=[{v:'condom_lastsex',t:80},{v:'hiv_test',t:60},{v:'prep_current',t:50},{v:'art_enrolled',t:90},{v:'satisfied',t:75}];
  const sites=[...new Set(allRows.map(r=>r.site))].slice(0,7);
  document.getElementById('heatBody').innerHTML=sites.map(s=>{
    const rr=allRows.filter(r=>r.site===s),co=rr[0]?.county||'';
    return`<tr><td>${s}</td><td>${co}</td>${hv.map(({v,t})=>{const val=pct(rr,v);return`<td><span class="hc ${hc(val,t)}">${val}%</span></td>`;}).join('')}</tr>`;
  }).join('');
}
function renderActions(){
  const sc={Done:'pd','In Progress':'pp','Overdue':'po'};
  const rows = actionRows.length ? actionRows : SAMPLE_ACTIONS;
  document.getElementById('actionBody').innerHTML=rows.map(a=>`<tr>
    <td>${a.site||a['Site Name']||''}</td>
    <td>${a.county||a['County']||''}</td>
    <td>${a.action||a['Action Item']||''}</td>
    <td>${a.lead||a['Lead']||''}</td>
    <td>${a.deadline||a['Deadline']||''}</td>
    <td><span class="pill ${sc[a.status||a['Status']]||'pp'}">${a.status||a['Status']||'Pending'}</span></td>
  </tr>`).join('');
}
function renderVarMap(){
  const rows=filteredRows.length?filteredRows:allRows;
  document.getElementById('varGrid').innerHTML=VAR_MAP.map(v=>{
    const val=pct(rows,v.var);
    const col=v.target?(val>=v.target?'#86efac':val>=v.target-10?'#fcd34d':'#fca5a5'):'#94a3b8';
    return`<div class="vm-row"><span class="vm-q">Q${v.q}</span><span style="font-size:10px;color:#94a3b8">${v.label}</span><span class="vm-var">${v.var}</span><span class="vm-val" style="color:${col}">${val}%</span></div>`;
  }).join('');
}

async function loadData() {
  loadConfig();
  if (CFG.sheetId && CFG.apiKey) {
    document.getElementById('connStatus') && (document.getElementById('connStatus').textContent='');
    try {
      const [aggRows, actRows] = await Promise.all([
        fetchTab(CFG.aggTab),
        fetchTab(CFG.actTab).catch(()=>[]),
      ]);
      allRows    = normaliseAgg(aggRows);
      actionRows = actRows;
      document.getElementById('trendBadge').textContent = 'Live';
      document.getElementById('trendBadge').className = 'badge';
      document.getElementById('statusDot').className = 'dot';
      document.getElementById('bannerText').innerHTML =
        `<b>${allRows.length}</b> records from Google Sheets &nbsp;&middot;&nbsp; Last sync: <b>${new Date().toLocaleTimeString()}</b>`;
      populateFilters(); applyFilters(); return;
    } catch(e) {
      document.getElementById('bannerText').innerHTML =
        `Could not reach Google Sheets &mdash; <b>${e.message}</b> &mdash; showing sample data`;
    }
  }
  allRows = makeSample(); actionRows = SAMPLE_ACTIONS;
  document.getElementById('trendBadge').textContent = 'Sample';
  document.getElementById('trendBadge').className = 'badge-grey';
  document.getElementById('statusDot').className = 'dot grey';
  document.getElementById('bannerText').innerHTML =
    `<b>${allRows.length}</b> sample records &mdash; click <b>Google Sheets</b> to connect live data`;
  populateFilters(); applyFilters();
}

// auto-open config if no credentials saved, else load directly
loadConfig();
if (!CFG.sheetId || !CFG.apiKey) {
  document.getElementById('configModal').classList.remove('hidden');
  allRows = makeSample(); actionRows = SAMPLE_ACTIONS;
  populateFilters(); applyFilters();
} else {
  document.getElementById('configModal').classList.add('hidden');
  loadData();
}
</script>
