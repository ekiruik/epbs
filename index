<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ePBS Dashboard — NASCOP/KRCS</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
:root{
  --bg:#0a0f1e;--surface:#111827;--surface2:#1a2235;--border:rgba(255,255,255,0.07);
  --accent:#00d4aa;--accent2:#4f9cf9;--text:#e2e8f0;--muted:#64748b;
  --danger:#ef4444;--success:#22c55e;--warn:#f59e0b;
  --font:"DM Sans",sans-serif;--mono:"DM Mono",monospace
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:var(--font);font-size:14px}
.header{background:#fff;border-bottom:3px solid #006633}
.logo-bar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:12px 28px;gap:16px}
.logo-slot{display:flex;align-items:center}
.logo-slot.left{justify-content:flex-start}
.logo-slot.center{justify-content:center}
.logo-slot.right{justify-content:flex-end}
.logo-box{display:flex;flex-direction:column;align-items:center;gap:5px}
.logo-img{height:68px;width:auto;object-fit:contain}
.logo-img.large{height:80px}
.logo-name{font-size:11px;font-weight:700;color:#1a3c5e;letter-spacing:.04em;text-align:center;font-family:"DM Sans",sans-serif}
.logo-full{font-size:9px;color:#64748b;text-align:center;max-width:130px;line-height:1.4;font-family:"DM Sans",sans-serif}
.title-bar{background:#006633;text-align:center;padding:10px 24px 12px}
.title-bar h1{font-size:15px;font-weight:700;color:#fff;letter-spacing:.06em;text-transform:uppercase;font-family:"DM Sans",sans-serif}
.title-bar p{font-size:11px;color:rgba(255,255,255,.75);margin-top:4px;font-family:"DM Sans",sans-serif}

/* ── CONFIG MODAL ── */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:200;display:flex;align-items:center;justify-content:center}
.modal-bg.hidden{display:none}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:24px;width:480px;max-width:90vw}
.modal h2{font-size:15px;font-weight:600;color:var(--text);margin-bottom:6px}
.modal p{font-size:12px;color:var(--muted);margin-bottom:18px;line-height:1.6}
.field{margin-bottom:14px}
.field label{display:block;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:5px}
.field input{width:100%;background:var(--surface2);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:8px 12px;font-family:var(--mono);font-size:12px}
.field input:focus{outline:none;border-color:var(--accent)}
.field-hint{font-size:10px;color:var(--muted);margin-top:4px;line-height:1.5}
.modal-btns{display:flex;gap:10px;margin-top:20px}
.btn-primary{background:var(--accent);color:#000;border:none;border-radius:6px;padding:8px 20px;font-family:var(--font);font-size:12px;font-weight:600;cursor:pointer;flex:1}
.btn-primary:hover{opacity:.85}
.btn-secondary{background:transparent;color:var(--muted);border:1px solid var(--border);border-radius:6px;padding:8px 16px;font-family:var(--font);font-size:12px;cursor:pointer}
.btn-secondary:hover{border-color:var(--muted)}
.conn-status{font-size:11px;margin-top:10px;padding:7px 10px;border-radius:6px;display:none}
.conn-ok{background:rgba(34,197,94,.15);color:#86efac;display:block}
.conn-err{background:rgba(239,68,68,.15);color:#fca5a5;display:block}

/* ── FILTER BAR ── */
.filterbar{display:flex;gap:8px;flex-wrap:wrap;padding:10px 24px;background:var(--surface);border-bottom:1px solid var(--border)}
select{background:var(--surface2);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:5px 10px;font-family:var(--font);font-size:11px;cursor:pointer}
select:focus{outline:none;border-color:var(--accent)}
.refresh{background:var(--accent);color:#000;border:none;border-radius:6px;padding:5px 14px;font-family:var(--font);font-size:12px;font-weight:600;cursor:pointer}
.refresh:hover{opacity:.85}
.settings-btn{background:transparent;color:var(--muted);border:1px solid var(--border);border-radius:6px;padding:5px 12px;font-family:var(--font);font-size:11px;cursor:pointer;margin-left:auto}
.settings-btn:hover{border-color:var(--accent);color:var(--accent)}

/* ── MAIN ── */
.main{padding:18px 24px;display:flex;flex-direction:column;gap:14px}
.banner{background:var(--surface2);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:8px;padding:9px 14px;font-size:11px;color:var(--muted);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.banner b{color:var(--text)}
.dot{width:7px;height:7px;border-radius:50%;background:var(--success);animation:pulse 2s infinite;flex-shrink:0}
.dot.grey{background:var(--muted);animation:none}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:10px}
.kpi{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 16px;border-bottom:3px solid transparent}
.kpi.g{border-bottom-color:var(--success)}.kpi.a{border-bottom-color:var(--warn)}.kpi.r{border-bottom-color:var(--danger)}
.kpi-lbl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px}
.kpi-val{font-size:26px;font-weight:600;font-family:var(--mono);line-height:1}
.kpi-tgt{font-size:10px;margin-top:5px}
.kpi-tgt.met{color:var(--success)}.kpi-tgt.near{color:var(--warn)}.kpi-tgt.miss{color:var(--danger)}
.panels{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.panel{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px}
.full{grid-column:1/-1}
@media(max-width:680px){.panels{grid-template-columns:1fr}}
.ptitle{font-size:12px;font-weight:600;margin-bottom:3px}
.psub{font-size:10px;color:var(--muted);margin-bottom:12px}
.phead{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:12px}
.badge{font-size:10px;padding:2px 8px;border-radius:4px;font-weight:600;background:rgba(0,212,170,.15);color:var(--accent)}
.badge-grey{font-size:10px;padding:2px 8px;border-radius:4px;font-weight:600;background:rgba(100,116,139,.15);color:var(--muted)}
.legend{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:8px}
.li{display:flex;align-items:center;gap:4px;font-size:10px;color:var(--muted)}
.lsq{width:9px;height:9px;border-radius:2px}
.bars{display:flex;flex-direction:column;gap:7px}
.brow{display:flex;align-items:center;gap:8px}
.blbl{font-size:11px;min-width:150px;flex-shrink:0}
.bbg{flex:1;height:8px;background:rgba(255,255,255,0.07);border-radius:4px;overflow:hidden}
.bfill{height:100%;border-radius:4px}
.bpct{font-size:11px;font-family:var(--mono);color:var(--muted);min-width:32px;text-align:right}
.ht{width:100%;border-collapse:collapse;font-size:11px}
.ht th{padding:5px 9px;text-align:left;color:var(--muted);font-size:10px;font-weight:500;border-bottom:1px solid var(--border);background:rgba(255,255,255,0.03)}
.ht td{padding:5px 9px;border-bottom:1px solid rgba(255,255,255,0.03)}
.ht tr:last-child td{border-bottom:none}
.hc{display:inline-block;padding:1px 8px;border-radius:3px;font-family:var(--mono);font-size:10px;font-weight:500}
.hg{background:rgba(34,197,94,.15);color:#86efac}
.ha{background:rgba(245,158,11,.15);color:#fcd34d}
.hr{background:rgba(239,68,68,.15);color:#fca5a5}
.at{width:100%;border-collapse:collapse;font-size:11px}
.at th{padding:6px 9px;text-align:left;font-size:10px;color:var(--muted);font-weight:500;border-bottom:1px solid var(--border);background:rgba(255,255,255,0.03)}
.at td{padding:6px 9px;border-bottom:1px solid rgba(255,255,255,0.04)}
.at tr:last-child td{border-bottom:none}
.pill{display:inline-block;font-size:10px;padding:2px 8px;border-radius:10px;font-weight:600}
.pd{background:rgba(34,197,94,.15);color:#86efac}
.pp{background:rgba(245,158,11,.15);color:#fcd34d}
.po{background:rgba(239,68,68,.15);color:#fca5a5}
.varmap{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:14px}
.varmap-title{font-size:12px;font-weight:600;color:var(--accent);margin-bottom:10px}
.vm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:6px}
.vm-row{display:flex;align-items:baseline;gap:6px;font-size:11px;padding:4px 8px;background:var(--surface);border-radius:5px;border:1px solid var(--border)}
.vm-q{color:var(--muted);min-width:24px;font-family:var(--mono)}
.vm-var{color:var(--accent2);font-family:var(--mono);font-size:10px}
.vm-val{margin-left:auto;font-family:var(--mono);font-size:11px;font-weight:600}
</style>
</head>
<body>

<!-- ═══ HEADER ═══ -->
<div class="header">
  <div class="logo-bar">
    <div class="logo-slot left">
      <div class="logo-box">
        <img class="logo-img" src="data:image/png;base64," alt="NASCOP">
